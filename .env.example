# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — writes, automation, admin.
# Supabase Studio → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Free at https://aistudio.google.com/apikey — Gemini 1.5 Flash is free up to 1500 req/day
GEMINI_API_KEY=

# Any random string — secures the /api/revalidate endpoint
REVALIDATE_SECRET=

# Used by the pipeline to ping revalidation after publishing
# (Vercel deployment URL, e.g. https://infocusit.vercel.app)
SITE_URL=
